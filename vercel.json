{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.vkotocozum.com"
        }
      ],
      "destination": "https://vkotocozum.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.vkotocozum.com"
        }
      ],
      "destination": "https://vkotocozum.com/:path*",
      "permanent": true
    }
  ]
}
